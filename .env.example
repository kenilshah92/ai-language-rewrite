OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.6-luna
# The app exposes only Luna, Terra, and Sol; other configured model IDs are rejected.
MAX_UPLOAD_MB=50
MIN_FONT_SCALE=0.85
APP_HOSTED=false
APP_USERNAME=
APP_PASSWORD=
# 0 keeps local files. Hosted deployments should set 24 or another positive duration.
FILE_RETENTION_HOURS=0
