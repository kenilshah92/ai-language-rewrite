OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.6-luna
# Comma-separated API model IDs available to your account; only these appear in the picker.
ALLOWED_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol,gpt-6-astra
MAX_UPLOAD_MB=50
MIN_FONT_SCALE=0.85
APP_HOSTED=false
APP_USERNAME=
APP_PASSWORD=
# 0 keeps local files. Hosted deployments should set 24 or another positive duration.
FILE_RETENTION_HOURS=0
